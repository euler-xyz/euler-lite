{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "csp:probe": "node scripts/csp-page-probe.mjs",
    "csp:controls": "node scripts/csp-browser-controls.mjs",
    "parity:compare": "node scripts/parity-compare.mjs",
    "parity:full": "node scripts/parity-compare.mjs --scenarios tests/parity/full-run.scenarios.json --rate-limit-retries 3",
    "parity:links": "node scripts/parity-links.mjs",
    "parity:sdk-diagnostics": "node scripts/parity-sdk-diagnostics.mjs",
    "parity:public-endpoints": "node scripts/public-endpoint-parity.mjs",
    "parity:overlay": "node scripts/parity-overlay.mjs",
    "execution:record": "node scripts/execution-record.mjs",
    "execution:suite": "node scripts/execution-suite.mjs",
    "execution:transfer-min": "node scripts/execution-sdk-transfer-min.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:golden": "vitest run tests/golden",
    "test:golden:update": "UPDATE_GOLDEN=1 vitest run tests/golden",
    "test:golden:fetch-fixtures": "jiti tests/golden/fetch-fixtures.ts",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare && simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@eulerxyz/euler-v2-sdk": "4.4.0",
    "@floating-ui/vue": "2.0.1",
    "@gvade/nuxt3-svg-sprite": "1.0.3",
    "@keyringnetwork/keyring-connect-sdk": "3.3.0",
    "@nuxt/eslint": "1.17.0",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tanstack/vue-query": "5.104.4",
    "@vueuse/nuxt": "15.0.0",
    "@wagmi/core": "3.6.5",
    "@wagmi/vue": "0.5.30",
    "axios": "1.20.0",
    "chart.js": "4.5.1",
    "chartjs-plugin-annotation": "3.1.0",
    "luxon": "3.7.2",
    "modern-normalize": "3.0.1",
    "nuxt": "4.6.2",
    "pino": "10.4.0",
    "viem": "2.57.7",
    "vue": "3.5.44",
    "vue-chartjs": "5.3.4",
    "vue-router": "5.4.0",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "lint-staged": "17.6.0",
    "playwright": "1.64.1",
    "sass": "1.105.2",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@base-org/account": "2.5.1",
    "@wagmi/connectors": "8.2.0",
    "serialize-javascript": "7.1.0",
    "ws": "8.21.3",
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    }
  },
  "license": "MIT"
}
