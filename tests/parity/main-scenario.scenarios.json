{
  "version": 1,
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "localStorage": {
      "is-onboarding-completed": "true",
      "migration-announcement-seen": "true"
    },
    "waitFor": [
      "[data-id]"
    ],
    "settleMs": 1000,
    "rateLimitRetries": 3,
    "persistenceRecheckMaxRatio": 0.5,
    "persistenceRecheckDelayMs": 300000
  },
  "scenarios": [
    {
      "id": "main-lend-list-mainnet",
      "label": "Main scenario: Mainnet lend list and first 20 vault details",
      "path": "/lend?network=1&showAll=true",
      "ignoreListDataPointsOnListPage": [
        {
          "listPrefix": "collateral-exposure:"
        }
      ],
      "waitFor": [
        "[data-id=\"vault-list\"][data-list=\"lend\"]"
      ],
      "modals": [
        {
          "id": "supply-apy",
          "label": "Supply APY modal",
          "selector": "css=[data-modal-trigger=\"supply-apy\"], :is(div, span):has-text(\"Supply APY\") > svg",
          "waitFor": [
            "[data-field=\"supply-apy-total\"]"
          ]
        },
        {
          "id": "filter-select",
          "label": "Filter select modal",
          "selector": "[data-id=\"filter-trigger\"]",
          "maxItems": 10,
          "waitFor": [
            "[data-id=\"select-modal\"]"
          ]
        },
        {
          "id": "custom-filter",
          "label": "Custom filter modal",
          "selector": "[data-id=\"custom-filter-trigger\"]",
          "waitFor": [
            "[data-id=\"custom-filter-modal\"]"
          ]
        }
      ],
      "follow": [
        {
          "id": "lend-vault-detail",
          "label": "Lend vault details",
          "selector": "[data-id=\"vault-list-item\"][data-list=\"lend\"]",
          "maxItems": 20,
          "waitFor": [
            "[data-id=\"vault-header\"]",
            "[data-id=\"data-point\"]"
          ]
        }
      ]
    },
    {
      "id": "main-lend-list-mainnet-default",
      "label": "Main scenario: Mainnet lend list with showAll disabled",
      "path": "/lend?network=1",
      "ignoreListDataPointsOnListPage": [
        {
          "listPrefix": "collateral-exposure:"
        }
      ],
      "waitFor": [
        "[data-id=\"vault-list\"][data-list=\"lend\"]"
      ]
    },
    {
      "id": "main-lend-list-spy-mainnet",
      "label": "Main scenario: Mainnet lend list with spy (viewer-aware rewards)",
      "path": "/lend?network=1&showAll=true&spy=0x75cFE4ef963232ae8313aC33e21fC39241338618",
      "ignoreListDataPointsOnListPage": [
        {
          "listPrefix": "collateral-exposure:"
        }
      ],
      "waitFor": [
        "[data-id=\"vault-list\"][data-list=\"lend\"]"
      ]
    },
    {
      "id": "main-lend-list-sort-supply-apy-mainnet",
      "label": "Main scenario: Mainnet lend list sorted by Supply APY",
      "path": "/lend?network=1&showAll=true",
      "waitFor": [
        "[data-id=\"vault-list\"][data-list=\"lend\"]"
      ],
      "actions": [
        {
          "type": "click",
          "selector": "[data-id=\"sort-trigger\"]",
          "waitFor": [
            "[data-id=\"sort-modal\"]"
          ],
          "waitForData": false
        },
        {
          "type": "click",
          "selector": "[data-id=\"sort-option\"][data-key=\"Supply APY\"]",
          "waitFor": [
            "[data-id=\"vault-list\"][data-list=\"lend\"]"
          ],
          "settleMs": 500
        }
      ]
    },
